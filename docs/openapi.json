  "components": {
    "schemas": {
      "CustomerRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "customerName": {
            "type": "string",
            "minLength": 1
          },
          "phone": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          }
        },
        "required": [
          "customerName",
          "phone"
        ]
      },
      "CustomerResponse": {
        "type": "object",
        "properties": {
          "customerNumber": {
            "type": "integer",
            "format": "int64"
          },
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "customerName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        }
      },
      "ProductRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "qty": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "price": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "price",
          "qty"
        ]
      },
      "ProductResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "qty": {
            "type": "integer",
